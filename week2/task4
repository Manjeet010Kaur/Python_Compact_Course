"""
Write a Python program to convert a given list of strings into list of lists using map function. 
"""
string_list = [
    "Manjeet",
    "Python",
    "Dortmund"
]
result_list = list(map(list, string_list))


print("Original List of Strings:")
print(string_list)


print("\nConverted List of Lists:")
print(result_list)